<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\Krypton.Shared\Krypton.WinFormsDesignerSdk.Server.props" />

	<PropertyGroup>
		<RootNamespace>Krypton.Ribbon</RootNamespace>
		<AssemblyName>Krypton.Ribbon.Design</AssemblyName>
		<Description>Out-of-process DesignToolsServer designers, action lists, and glyphs for Krypton.Ribbon on modern Windows TFMs (WinForms Designer Extensibility SDK). Packed under lib\{tfm}\Design\WinForms\Server\.</Description>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\Krypton.Ribbon\Designers\Designers\**\*.cs" Link="Designers\Designers\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\Krypton.Ribbon\Designers\Action Lists\**\*.cs" Link="Designers\Action Lists\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\Krypton.Shared\KryptonDesignerTypeRoutingProvider.cs" Link="KryptonDesignerTypeRoutingProvider.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Krypton.Ribbon\Krypton.Ribbon 2022.csproj" />
		<ProjectReference Include="..\Krypton.Toolkit.Design\Krypton.Toolkit.Design.csproj" />
		<ProjectReference Include="..\Krypton.Interop\Krypton.Interop.csproj" PrivateAssets="all" />
	</ItemGroup>

</Project>
