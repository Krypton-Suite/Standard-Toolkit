<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\Krypton.Shared\Krypton.WinFormsDesignerSdk.Server.props" />

	<PropertyGroup>
		<RootNamespace>Krypton.Gauges</RootNamespace>
		<AssemblyName>Krypton.Gauges.Design</AssemblyName>
		<Description>Out-of-process designers for Krypton.Gauges. Not a separate NuGet package; packed under lib\{tfm}\Design\WinForms\Server\ by Krypton.Standard.Toolkit.</Description>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\Krypton.Gauges\Components\**\Designers\Designers\**\*.cs" Link="Designers\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\Krypton.Gauges\Components\**\Designers\Action Lists\**\*.cs" Link="ActionLists\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\Krypton.Shared\KryptonDesignerTypeRoutingProvider.cs" Link="KryptonDesignerTypeRoutingProvider.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Krypton.Gauges\Krypton.Gauges.csproj" />
		<ProjectReference Include="..\Krypton.Toolkit.Design\Krypton.Toolkit.Design.csproj" />
		<ProjectReference Include="..\Krypton.Interop\Krypton.Interop.csproj" PrivateAssets="all" />
	</ItemGroup>

</Project>
