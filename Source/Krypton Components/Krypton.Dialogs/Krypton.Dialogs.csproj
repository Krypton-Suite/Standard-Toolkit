<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>Krypton.Dialogs</RootNamespace>
		<AssemblyName>Krypton.Dialogs</AssemblyName>
		<IsPackable>false</IsPackable>
		<CheckEolTargetFramework>false</CheckEolTargetFramework>
		<SignAssembly>True</SignAssembly>
		<AssemblyOriginatorKeyFile>..\Krypton.Toolkit.Utilities\StrongKrypton.snk</AssemblyOriginatorKeyFile>
		<ApplicationIcon>..\Krypton.Toolkit.Utilities\Krypton.ico</ApplicationIcon>
		<DelaySign>false</DelaySign>
		<UseWindowsForms>true</UseWindowsForms>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<NeutralLanguage>en</NeutralLanguage>
		<DisableImplicitNamespaceImports>true</DisableImplicitNamespaceImports>
		<Configurations>Debug;Release;Installer;Nightly;Canary;RC</Configurations>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Nullable>enable</Nullable>
		<WarningLevel>8</WarningLevel>
		<AnalysisLevel>latest</AnalysisLevel>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<ForceDesignerDPIUnaware>true</ForceDesignerDPIUnaware>
		<ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
		<NoWarn>1701;1702</NoWarn>
		<Description>Krypton file-operation progress, conflict, and confirmation dialogs backed by IFileOperation. Included in the Krypton.Standard.Toolkit NuGet package and not published on its own.</Description>
	</PropertyGroup>

	<ItemGroup>
		<!-- Direct Interop ref required because Krypton.Toolkit uses PrivateAssets="all" (#3908). -->
		<ProjectReference Include="..\Krypton.Interop\Krypton.Interop.csproj" PrivateAssets="all" />
		<ProjectReference Include="..\Krypton.Toolkit\Krypton.Toolkit 2022.csproj" />
		<!-- Progress dialog hosts KryptonTransferSpeedGraph from Utilities. -->
		<ProjectReference Include="..\Krypton.Toolkit.Utilities\Krypton.Toolkit.Utilities.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Controls\VisualFileConflictForm.resx">
			<DependentUpon>VisualFileConflictForm.cs</DependentUpon>
		</EmbeddedResource>
		<EmbeddedResource Update="Controls\VisualFileDeleteConfirmForm.resx">
			<DependentUpon>VisualFileDeleteConfirmForm.cs</DependentUpon>
		</EmbeddedResource>
		<EmbeddedResource Update="Controls\VisualFileOperationProgressForm.resx">
			<DependentUpon>VisualFileOperationProgressForm.cs</DependentUpon>
		</EmbeddedResource>
		<Compile Update="Controls\VisualFileConflictForm.Designer.cs">
			<DependentUpon>VisualFileConflictForm.cs</DependentUpon>
		</Compile>
		<Compile Update="Controls\VisualFileDeleteConfirmForm.Designer.cs">
			<DependentUpon>VisualFileDeleteConfirmForm.cs</DependentUpon>
		</Compile>
		<Compile Update="Controls\VisualFileOperationProgressForm.Designer.cs">
			<DependentUpon>VisualFileOperationProgressForm.cs</DependentUpon>
		</Compile>
	</ItemGroup>

</Project>
