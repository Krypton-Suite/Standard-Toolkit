<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>Krypton.Toolkit</RootNamespace>
		<AssemblyName>Krypton.Resources</AssemblyName>
		<!-- RootNamespace stays Krypton.Toolkit so typed .resx resource names and Designer namespaces remain stable. -->
		<IsPackable>false</IsPackable>
		<CheckEolTargetFramework>false</CheckEolTargetFramework>
		<SignAssembly>True</SignAssembly>
		<AssemblyOriginatorKeyFile>StrongKrypton.snk</AssemblyOriginatorKeyFile>
		<DelaySign>false</DelaySign>
		<UseWindowsForms>true</UseWindowsForms>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<NeutralLanguage>en</NeutralLanguage>
		<DisableImplicitNamespaceImports>true</DisableImplicitNamespaceImports>
		<Configurations>Debug;Release;Installer;Nightly;Canary;RC</Configurations>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<Nullable>enable</Nullable>
		<WarningLevel>8</WarningLevel>
		<AnalysisLevel>latest</AnalysisLevel>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<NoWarn>1701;1702</NoWarn>
		<Description>Shared image and string resource bank for the Krypton suite (theme chrome, toolbars, glyphs, dialogs). Bundled into Krypton.Toolkit and sibling NuGet packages; not published as a separate package.</Description>
	</PropertyGroup>

