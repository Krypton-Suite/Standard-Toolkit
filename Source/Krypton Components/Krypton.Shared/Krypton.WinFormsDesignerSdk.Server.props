<Project>
	<!-- DesignToolsServer assemblies: modern Windows TFMs only. -->
	<Import Project="$(MSBuildThisFileDirectory)Krypton.WinFormsDesignerSdk.props" />

	<Choose>
		<When Condition="'$(KryptonWinFormsDesignerSdkEnabled)' != 'true'">
			<PropertyGroup>
				<TargetFrameworks>net8.0-windows</TargetFrameworks>
			</PropertyGroup>
		</When>
		<When Condition="'$(ExcludeVs2022UnsupportedTargetFrameworks)' == 'true'">
			<PropertyGroup>
				<TargetFrameworks>net8.0-windows;net9.0-windows</TargetFrameworks>
			</PropertyGroup>
		</When>
		<When Condition="'$(ExcludeNet11)' == 'true'">
			<PropertyGroup>
				<TargetFrameworks>net8.0-windows;net9.0-windows;net10.0-windows</TargetFrameworks>
			</PropertyGroup>
		</When>
		<Otherwise>
			<PropertyGroup>
				<TargetFrameworks>net8.0-windows;net9.0-windows;net10.0-windows;net11.0-windows</TargetFrameworks>
			</PropertyGroup>
		</Otherwise>
	</Choose>
</Project>
