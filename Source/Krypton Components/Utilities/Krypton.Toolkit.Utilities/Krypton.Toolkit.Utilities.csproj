<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>Krypton.Toolkit.Utilities</RootNamespace>
		<AssemblyName>Krypton.Toolkit.Utilities</AssemblyName>
		<IsPackable>false</IsPackable>
		<!-- Disable CheckEolTargetFramework to suppress this warning. -->
		<CheckEolTargetFramework>false</CheckEolTargetFramework>
		<SignAssembly>True</SignAssembly>
		<AssemblyOriginatorKeyFile>StrongKrypton.snk</AssemblyOriginatorKeyFile>
		<ApplicationIcon>Krypton.ico</ApplicationIcon>
		<DelaySign>false</DelaySign>
		<UseWindowsForms>true</UseWindowsForms>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<NeutralLanguage>en</NeutralLanguage>
		<DisableImplicitNamespaceImports>true</DisableImplicitNamespaceImports>
		<Configurations>Debug;Release;Installer;Nightly;Canary;RC;LTS</Configurations>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Nullable>enable</Nullable>
		<!--https://learn.microsoft.com/en-us/dotnet/csharp/language-reference/compiler-messages/warning-waves-->
		<WarningLevel>8</WarningLevel>
		<AnalysisLevel>latest</AnalysisLevel>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<!--https://learn.microsoft.com/en-us/visualstudio/designers/disable-dpi-awareness?view=vs-2022-->
		<ForceDesignerDPIUnaware>true</ForceDesignerDPIUnaware>
		<ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
		<!-- WFO5002: Form.ShowAsync / ShowDialogAsync experimental on net9; stable on net10+ -->
		<NoWarn>1701;1702;WFO5002</NoWarn>
		<Description>Optional Krypton.Toolkit utilities assembly: AboutBox, toast and exception dialogs, command-link buttons, floating toolbars, palette file selectors, file-system views, transfer-speed graph, WebView2 helpers, and related controls. Included in the Krypton.Standard.Toolkit NuGet package.</Description>
	</PropertyGroup>

	<Import Project="..\..\Common\Krypton.SharedCompileItems.props" />
	<PropertyGroup>
		<IncludeKryptonUtilitiesSourceLinks>true</IncludeKryptonUtilitiesSourceLinks>
	</PropertyGroup>

	<ItemGroup>
	  <Content Include="Utilities\WinFormAnimatiion\General\Icon.png" />
	  <Content Include="Krypton.ico">
	    <Pack>false</Pack>
	  </Content>
	</ItemGroup>

	<!-- System.Design reference for designer support -->
	<ItemGroup>
		<Reference Include="System.Design, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" Condition="'$(TargetFramework)' == 'net472' Or '$(TargetFramework)' == 'net48' Or '$(TargetFramework)' == 'net481'">
			<SpecificVersion>True</SpecificVersion>
			<Version>4.0.0.0</Version>
		</Reference>
		<Reference Include="System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" Condition="$(TargetFramework.StartsWith('net4'))">
			<SpecificVersion>True</SpecificVersion>
			<Version>4.0.0.0</Version>
		</Reference>
		<Reference Include="System.Net.Http" Condition="$(TargetFramework.StartsWith('net4'))" />
		<Reference Include="System.Management" Condition="$(TargetFramework.StartsWith('net4'))" />
	</ItemGroup>

	<ItemGroup Condition="!$(TargetFramework.StartsWith('net4'))">
		<PackageReference Include="System.Management" Version="8.0.0" />
	</ItemGroup>

	<!-- WebView2: bundled DLLs in Lib/WebView2 (all target frameworks). Run Scripts\WebVew2\Populate-BundledWebView2.cmd to populate. -->
	<PropertyGroup>
		<WebView2LibPath>$(MSBuildThisFileDirectory)Lib\WebView2</WebView2LibPath>
		<WebView2CoreDll>$(WebView2LibPath)\Microsoft.Web.WebView2.Core.dll</WebView2CoreDll>
		<WebView2WinFormsDll>$(WebView2LibPath)\Microsoft.Web.WebView2.WinForms.dll</WebView2WinFormsDll>
	</PropertyGroup>

	<!-- WebView2 references: use bundled DLLs when present -->
	<ItemGroup Condition="Exists('$(WebView2CoreDll)') And Exists('$(WebView2WinFormsDll)')">
		<Reference Include="Microsoft.Web.WebView2.Core">
			<HintPath>$(WebView2CoreDll)</HintPath>
			<Private>True</Private>
		</Reference>
		<Reference Include="Microsoft.Web.WebView2.WinForms">
			<HintPath>$(WebView2WinFormsDll)</HintPath>
			<Private>True</Private>
		</Reference>
	</ItemGroup>

	<!-- Define WEBVIEW2_AVAILABLE when bundled WebView2 DLLs exist -->
	<PropertyGroup Condition="Exists('$(WebView2CoreDll)') And Exists('$(WebView2WinFormsDll)')">
		<DefineConstants>$(DefineConstants);WEBVIEW2_AVAILABLE</DefineConstants>
	</PropertyGroup>

	<!-- WebView2 Toolbox Bitmap -->
	<ItemGroup>
		<EmbeddedResource Include="Components\Krypton WebView2\ToolboxBitmaps\WebView2.bmp" />
	</ItemGroup>

	<ItemGroup>
	  <!-- Krypton.Interop: direct reference required (net4x nullable attribute polyfills via InternalsVisibleTo);
		   no longer flows transitively from Krypton.Toolkit (PrivateAssets="all", #3908). -->
			<!-- Krypton.Resources: direct reference required (typed ResourceFiles accessors via InternalsVisibleTo); PrivateAssets so it is not a NuGet dependency (bundled via Krypton.Resources.Package.targets). -->
		<ProjectReference Include="..\..\Shared\Krypton.Resources\Krypton.Resources.csproj" PrivateAssets="all" />
		<ProjectReference Include="..\..\Shared\Krypton.Shared\Krypton.Shared.csproj" PrivateAssets="all" />
	  <ProjectReference Include="..\..\Core\Krypton.Navigator\Krypton.Navigator 2022.csproj" />
	  <ProjectReference Include="..\..\Core\Krypton.Ribbon\Krypton.Ribbon 2022.csproj" />
	  <ProjectReference Include="..\..\Core\Krypton.Toolkit\Krypton.Toolkit 2022.csproj" />
	  <ProjectReference Include="..\..\Core\Krypton.Workspace\Krypton.Workspace 2022.csproj" />
	</ItemGroup>
	<ItemGroup Condition="!$(TargetFramework.StartsWith('net4'))">
	  <Compile Remove="Components\**\Designers\Designers\**\*.cs" />
	  <Compile Remove="Components\**\Designers\Action Lists\**\*.cs" />
	  <Compile Remove="Components\Krypton Custom Strings\Designers\KryptonCustomStringsManagerDesigner.cs" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Components\Krypton Drop Zone\Resources\DropZoneResources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <CustomToolNamespace>Krypton.Toolkit.Utilities</CustomToolNamespace>
	    <LastGenOutput>DropZoneResources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Components\Krypton Search Box\Resource Files\SearchBoxImageResources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <CustomToolNamespace>Krypton.Toolkit.Utilities</CustomToolNamespace>
	    <LastGenOutput>SearchBoxImageResources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Components\Krypton Toast\Resources\ToastImageResources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>ToastImageResources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Properties\Resources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Components\Krypton System Information\Controls Visuals\VisualSystemInformationForm.resx">
	    <DependentUpon>VisualSystemInformationForm.cs</DependentUpon>
	  </EmbeddedResource>
	  <!-- Toast form .resx files sit under deep folders. The path-derived manifest name exceeds MAX_PATH
	       for obj intermediates (issue #4636). Use namespace + type name, which matches the form namespace.
	       Leave ToastImageResources on its path-derived name; its designer looks that id up. -->
	  <EmbeddedResource Update="Components\Krypton Toast\Controls Visuals\**\*.resx">
	    <ManifestResourceName>Krypton.Toolkit.Utilities.%(Filename)</ManifestResourceName>
	    <LogicalName>Krypton.Toolkit.Utilities.%(Filename).resources</LogicalName>
	  </EmbeddedResource>
	  <!-- These form .resx files also exceed the obj path limit once the project sits under Utilities\ (issue #4636). -->
	  <EmbeddedResource Update="Components\Krypton Floating Toolbars\Controls Visuals\VisualMenuStripExistingComponentChooserForm.resx">
	    <ManifestResourceName>Krypton.Toolkit.Utilities.%(Filename)</ManifestResourceName>
	    <LogicalName>Krypton.Toolkit.Utilities.%(Filename).resources</LogicalName>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Components\Krypton Floating Toolbars\Controls Visuals\VisualToolStripExistingComponentChooserForm.resx">
	    <ManifestResourceName>Krypton.Toolkit.Utilities.%(Filename)</ManifestResourceName>
	    <LogicalName>Krypton.Toolkit.Utilities.%(Filename).resources</LogicalName>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Components\Krypton Palette Collection Editor\Controls Visuals\VisualKryptonPaletteCollectionEditorForm.resx">
	    <ManifestResourceName>Krypton.Toolkit.Utilities.%(Filename)</ManifestResourceName>
	    <LogicalName>Krypton.Toolkit.Utilities.%(Filename).resources</LogicalName>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Resources\" />
	  <Folder Include="Components\Krypton System Information\" />
	  <Folder Include="Components\Krypton System Information\Controls Toolkit\" />
	  <Folder Include="Components\Krypton System Information\Controls Visuals\" />
	  <Folder Include="Components\Krypton System Information\General\" />
	  <Folder Include="Components\Krypton System Information\Providers\" />
	  <Folder Include="Components\Krypton System Information\Translations\" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Components\Krypton System Information\Controls Visuals\VisualSystemInformationForm.cs">
	    <SubType>Form</SubType>
	  </Compile>
	  <Compile Update="Components\Krypton System Information\Controls Visuals\VisualSystemInformationForm.Designer.cs">
	    <DependentUpon>VisualSystemInformationForm.cs</DependentUpon>
	  </Compile>
	  <Compile Update="Components\Krypton Splash Screen Manager\Controls Visuals\VisualSplashScreenManagerForm.cs">
	    <SubType>Form</SubType>
	  </Compile>
	  <Compile Update="Components\Krypton Logger\Controls Visuals\VisualKryptonLogViewerForm.cs">
	    <SubType>Form</SubType>
	  </Compile>
	  <Compile Update="Components\Krypton AboutBox\Controls Visuals\VisualAboutBoxForm.cs">
	    <SubType>Form</SubType>
	  </Compile>
	  <Compile Update="Components\Krypton AboutBox\View Base\InternalAssemblyDetails.cs">
	    <SubType>UserControl</SubType>
	  </Compile>
	  <Compile Update="Components\Krypton Drop Zone\Resources\DropZoneResources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>DropZoneResources.resx</DependentUpon>
	  </Compile>
	  <Compile Update="Components\Krypton Search Box\Resource Files\SearchBoxImageResources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>SearchBoxImageResources.resx</DependentUpon>
	  </Compile>
	  <Compile Update="Components\Krypton Toast\Resources\ToastImageResources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>ToastImageResources.resx</DependentUpon>
	  </Compile>
	  <Compile Update="Properties\Resources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resources.resx</DependentUpon>
	  </Compile>
	  <Compile Update="$(KryptonSharedRoot)Utilities\FileSystemIconHelper.cs" Link="Components\Krypton File System Tree View\Utilities\FileSystemIconHelper.cs" />
	  <Compile Update="Components\Krypton Application Updater\Controls Visuals\VisualApplicationUpdatePromptForm.cs">
	    <SubType>Form</SubType>
	  </Compile>
	  <Compile Update="Components\Krypton Application Updater\Controls Visuals\VisualApplicationUpdatePromptForm.Designer.cs">
	    <DependentUpon>VisualApplicationUpdatePromptForm.cs</DependentUpon>
	  </Compile>
	  <Compile Update="Components\Krypton Application Updater\Controls Visuals\VisualApplicationUpdateProgressForm.cs">
	    <SubType>Form</SubType>
	  </Compile>
	  <Compile Update="Components\Krypton Application Updater\Controls Visuals\VisualApplicationUpdateProgressForm.Designer.cs">
	    <DependentUpon>VisualApplicationUpdateProgressForm.cs</DependentUpon>
	  </Compile>
	  <Compile Update="Components\Krypton Application Updater\Controls Visuals\VisualApplicationUpdateNotesForm.cs">
	    <SubType>Form</SubType>
	  </Compile>
	  <Compile Update="Components\Krypton Application Updater\Controls Visuals\VisualApplicationUpdateNotesForm.Designer.cs">
	    <DependentUpon>VisualApplicationUpdateNotesForm.cs</DependentUpon>
	  </Compile>
	  <Compile Update="Components\Krypton Application Updater\Controls Visuals\VisualApplicationUpdatePostponeForm.cs">
	    <SubType>Form</SubType>
	  </Compile>
	  <Compile Update="Components\Krypton Application Updater\Controls Visuals\VisualApplicationUpdatePostponeForm.Designer.cs">
	    <DependentUpon>VisualApplicationUpdatePostponeForm.cs</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Components\Krypton Application Updater\Controls Visuals\VisualApplicationUpdatePromptForm.resx">
	    <DependentUpon>VisualApplicationUpdatePromptForm.cs</DependentUpon>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Components\Krypton Application Updater\Controls Visuals\VisualApplicationUpdateProgressForm.resx">
	    <DependentUpon>VisualApplicationUpdateProgressForm.cs</DependentUpon>
	  </EmbeddedResource>
	</ItemGroup>

	<!-- The helper is a net472 exe embedded in every utilities TFM. It is not a compile or package reference. -->
	<ItemGroup>
	  <ProjectReference Include="..\Krypton.Toolkit.Utilities.UpdateHelper\Krypton.Toolkit.Utilities.UpdateHelper.csproj">
	    <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
	    <Private>false</Private>
	    <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
	    <GlobalPropertiesToRemove>TargetFramework</GlobalPropertiesToRemove>
	    <AdditionalProperties>TargetFramework=net472</AdditionalProperties>
	    <SetTargetFramework>TargetFramework=net472</SetTargetFramework>
	  </ProjectReference>
	</ItemGroup>

	<Target Name="EmbedUpdateHelper" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectReferences" Condition="'$(DesignTimeBuild)' != 'true'">
	  <PropertyGroup>
	    <_UpdateHelperExe>$(KryptonBuildOutputRoot)$(Configuration)\net472\Krypton.Toolkit.Utilities.UpdateHelper.exe</_UpdateHelperExe>
	  </PropertyGroup>
	  <Error Condition="!Exists('$(_UpdateHelperExe)')" Text="Krypton.Toolkit.Utilities.UpdateHelper.exe was not produced at $(_UpdateHelperExe). Zip updates cannot be embedded." />
	  <ItemGroup>
	    <EmbeddedResource Include="$(_UpdateHelperExe)">
	      <LogicalName>Krypton.Toolkit.Utilities.UpdateHelper.exe</LogicalName>
	      <ManifestResourceName>Krypton.Toolkit.Utilities.UpdateHelper.exe</ManifestResourceName>
	    </EmbeddedResource>
	  </ItemGroup>
	</Target>

</Project>
