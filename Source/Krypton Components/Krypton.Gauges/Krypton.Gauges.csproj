<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>Krypton.Gauges</RootNamespace>
		<AssemblyName>Krypton.Gauges</AssemblyName>
		<IsPackable>false</IsPackable>
		<CheckEolTargetFramework>false</CheckEolTargetFramework>
		<SignAssembly>True</SignAssembly>
		<AssemblyOriginatorKeyFile>..\Krypton.Toolkit.Utilities\StrongKrypton.snk</AssemblyOriginatorKeyFile>
		<DelaySign>false</DelaySign>
		<UseWindowsForms>true</UseWindowsForms>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<NeutralLanguage>en</NeutralLanguage>
		<DisableImplicitNamespaceImports>true</DisableImplicitNamespaceImports>
		<Configurations>Debug;Release;Installer;Nightly;Canary;RC</Configurations>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Nullable>enable</Nullable>
		<WarningLevel>8</WarningLevel>
		<AnalysisLevel>latest</AnalysisLevel>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<ForceDesignerDPIUnaware>true</ForceDesignerDPIUnaware>
		<ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
		<NoWarn>1701;1702</NoWarn>
		<Description>Krypton gauge controls, including the VU meter, equalizer, and circular, linear, rectangular, thermometer, and ampere-meter analogue gauges. This assembly is not a separate NuGet package; Krypton.Gauges.dll is included in the Krypton.Standard.Toolkit package.</Description>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="System.Design, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" Condition="'$(TargetFramework)' == 'net472' Or '$(TargetFramework)' == 'net48' Or '$(TargetFramework)' == 'net481'">
			<SpecificVersion>True</SpecificVersion>
			<Version>4.0.0.0</Version>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Krypton.Interop\Krypton.Interop.csproj" PrivateAssets="all" />
		<ProjectReference Include="..\Krypton.Toolkit\Krypton.Toolkit 2022.csproj" />
	</ItemGroup>

	<ItemGroup Condition="!$(TargetFramework.StartsWith('net4'))">
		<Compile Remove="Components\**\Designers\Designers\**\*.cs" />
		<Compile Remove="Components\**\Designers\Action Lists\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Components\Krypton VU Meter\ToolboxBitmaps\KryptonVuMeter.bmp">
			<LogicalName>Krypton.Gauges.ToolboxBitmaps.KryptonVuMeter.bmp</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Components\Krypton Equalizer\ToolboxBitmaps\KryptonEqualizer.bmp">
			<LogicalName>Krypton.Gauges.ToolboxBitmaps.KryptonEqualizer.bmp</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Components\Krypton Circular Gauge\ToolboxBitmaps\KryptonCircularGauge.bmp">
			<LogicalName>Krypton.Gauges.ToolboxBitmaps.KryptonCircularGauge.bmp</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Components\Krypton Linear Gauge\ToolboxBitmaps\KryptonLinearGauge.bmp">
			<LogicalName>Krypton.Gauges.ToolboxBitmaps.KryptonLinearGauge.bmp</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Components\Krypton Rectangular Gauge\ToolboxBitmaps\KryptonRectangularGauge.bmp">
			<LogicalName>Krypton.Gauges.ToolboxBitmaps.KryptonRectangularGauge.bmp</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Components\Krypton Thermometer Gauge\ToolboxBitmaps\KryptonThermometerGauge.bmp">
			<LogicalName>Krypton.Gauges.ToolboxBitmaps.KryptonThermometerGauge.bmp</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Components\Krypton Ampere Meter Gauge\ToolboxBitmaps\KryptonAmpereMeterGauge.bmp">
			<LogicalName>Krypton.Gauges.ToolboxBitmaps.KryptonAmpereMeterGauge.bmp</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

</Project>
