<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>Krypton.Charting</RootNamespace>
		<AssemblyName>Krypton.Charting</AssemblyName>
		<IsPackable>false</IsPackable>
		<CheckEolTargetFramework>false</CheckEolTargetFramework>
		<SignAssembly>True</SignAssembly>
		<AssemblyOriginatorKeyFile>..\Krypton.Interop\StrongKrypton.snk</AssemblyOriginatorKeyFile>
		<ApplicationIcon>..\Krypton.Toolkit.Utilities\Krypton.ico</ApplicationIcon>
		<DelaySign>false</DelaySign>
		<UseWindowsForms>true</UseWindowsForms>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<NeutralLanguage>en</NeutralLanguage>
		<DisableImplicitNamespaceImports>true</DisableImplicitNamespaceImports>
		<Configurations>Debug;Release;Installer;Nightly;Canary;RC;LTS</Configurations>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Nullable>enable</Nullable>
		<WarningLevel>8</WarningLevel>
		<AnalysisLevel>latest</AnalysisLevel>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<ForceDesignerDPIUnaware>true</ForceDesignerDPIUnaware>
		<ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
		<NoWarn>1701;1702</NoWarn>
		<Description>Timeline controls for the Krypton Standard Toolkit. Included in the Krypton.Standard.Toolkit NuGet package and not published as its own package.</Description>
	</PropertyGroup>

	<ItemGroup>
		<!-- Direct Interop ref required because Krypton.Toolkit uses PrivateAssets="all" (#3908). -->
		<ProjectReference Include="..\Krypton.Interop\Krypton.Interop.csproj" PrivateAssets="all" />
		<ProjectReference Include="..\Krypton.Toolkit\Krypton.Toolkit 2022.csproj" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
		<Reference Include="System.Design" />
	</ItemGroup>

	<ItemGroup Condition="!$(TargetFramework.StartsWith('net4'))">
		<Compile Remove="Designers\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="ToolboxBitmaps\KryptonTimeline.bmp" />
		<EmbeddedResource Include="ToolboxBitmaps\KryptonDateTimeline.bmp" />
	</ItemGroup>

</Project>
