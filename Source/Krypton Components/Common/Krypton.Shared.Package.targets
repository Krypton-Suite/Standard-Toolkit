<Project>
	<!--
	  Include Krypton.Interop.dll in packable Krypton module packages.
	  Must use TargetsForTfmSpecificContentInPackage — BeforeTargets="_GetPackageFiles" does not
	  feed TfmSpecificPackageFile into NuGet's _GetTfmSpecificContentForPackage walk.
	  Krypton.Standard.Toolkit has its own explicit inclusion target.
	-->
	<PropertyGroup Condition="'$(IsPackable)' != 'false' And '$(PackageId)' != '' And !$(PackageId.StartsWith('Krypton.Standard.Toolkit'))">
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);KryptonIncludeSharedInPackage</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<Target Name="KryptonIncludeSharedInPackage">
		<PropertyGroup>
			<_KryptonSharedLibDir>$(KryptonBuildOutputRoot)$(Configuration)\$(TargetFramework)\</_KryptonSharedLibDir>
			<!-- Match NuGet Windows TFM folder naming (lib\netX.0-windows7.0\). -->
			<_KryptonSharedLibFolderName Condition="'$(_KryptonPackageLibFolder)' != ''">$(_KryptonPackageLibFolder)</_KryptonSharedLibFolderName>
			<_KryptonSharedLibFolderName Condition="'$(_KryptonSharedLibFolderName)' == ''">$(TargetFramework)</_KryptonSharedLibFolderName>
		</PropertyGroup>
		<ItemGroup>
			<TfmSpecificPackageFile Include="$(_KryptonSharedLibDir)Krypton.Interop.dll" Condition="Exists('$(_KryptonSharedLibDir)Krypton.Interop.dll')">
				<PackagePath>lib\$(_KryptonSharedLibFolderName)\</PackagePath>
			</TfmSpecificPackageFile>
			<TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)..\Shared\Krypton.Shared\bin\$(Configuration)\$(TargetFramework)\Krypton.Interop.dll" Condition="!Exists('$(_KryptonSharedLibDir)Krypton.Interop.dll') And Exists('$(MSBuildThisFileDirectory)..\Shared\Krypton.Shared\bin\$(Configuration)\$(TargetFramework)\Krypton.Interop.dll')">
				<PackagePath>lib\$(_KryptonSharedLibFolderName)\</PackagePath>
			</TfmSpecificPackageFile>
			<TfmSpecificPackageFile Include="$(_KryptonSharedLibDir)Krypton.Interop.xml" Condition="Exists('$(_KryptonSharedLibDir)Krypton.Interop.xml')">
				<PackagePath>lib\$(_KryptonSharedLibFolderName)\</PackagePath>
			</TfmSpecificPackageFile>
			<TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)..\Shared\Krypton.Shared\bin\$(Configuration)\$(TargetFramework)\Krypton.Interop.xml" Condition="!Exists('$(_KryptonSharedLibDir)Krypton.Interop.xml') And Exists('$(MSBuildThisFileDirectory)..\Shared\Krypton.Shared\bin\$(Configuration)\$(TargetFramework)\Krypton.Interop.xml')">
				<PackagePath>lib\$(_KryptonSharedLibFolderName)\</PackagePath>
			</TfmSpecificPackageFile>
			<TfmSpecificPackageFile Include="$(_KryptonSharedLibDir)Krypton.Interop.pdb" Condition="'$(IncludeSymbols)' == 'true' And Exists('$(_KryptonSharedLibDir)Krypton.Interop.pdb')">
				<PackagePath>lib\$(_KryptonSharedLibFolderName)\</PackagePath>
			</TfmSpecificPackageFile>
			<TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)..\Shared\Krypton.Shared\bin\$(Configuration)\$(TargetFramework)\Krypton.Interop.pdb" Condition="'$(IncludeSymbols)' == 'true' And !Exists('$(_KryptonSharedLibDir)Krypton.Interop.pdb') And Exists('$(MSBuildThisFileDirectory)..\Shared\Krypton.Shared\bin\$(Configuration)\$(TargetFramework)\Krypton.Interop.pdb')">
				<PackagePath>lib\$(_KryptonSharedLibFolderName)\</PackagePath>
			</TfmSpecificPackageFile>
		</ItemGroup>
	</Target>
</Project>
