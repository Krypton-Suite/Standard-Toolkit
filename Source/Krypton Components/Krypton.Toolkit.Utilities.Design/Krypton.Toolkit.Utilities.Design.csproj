<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\Krypton.Shared\Krypton.WinFormsDesignerSdk.Server.props" />

	<PropertyGroup>
		<RootNamespace>Krypton.Toolkit.Utilities</RootNamespace>
		<AssemblyName>Krypton.Toolkit.Utilities.Design</AssemblyName>
		<Description>Out-of-process DesignToolsServer designers, action lists, and glyphs for Krypton.Toolkit.Utilities on modern Windows TFMs (WinForms Designer Extensibility SDK). Packed under lib\{tfm}\Design\WinForms\Server\ via Krypton.Standard.Toolkit.</Description>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\Krypton.Toolkit.Utilities\Components\**\Designers\Designers\**\*.cs" Link="Designers\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\Krypton.Toolkit.Utilities\Components\**\Designers\Action Lists\**\*.cs" Link="ActionLists\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\Krypton.Toolkit.Utilities\Components\Krypton Custom Strings\Designers\KryptonCustomStringsManagerDesigner.cs" Link="Designers\KryptonCustomStringsManagerDesigner.cs" />
		<Compile Include="..\Krypton.Shared\KryptonDesignerTypeRoutingProvider.cs" Link="KryptonDesignerTypeRoutingProvider.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Krypton.Toolkit.Utilities\Krypton.Toolkit.Utilities.csproj" />
		<ProjectReference Include="..\Krypton.Toolkit.Design\Krypton.Toolkit.Design.csproj" />
		<ProjectReference Include="..\Krypton.Interop\Krypton.Interop.csproj" PrivateAssets="all" />
	</ItemGroup>

</Project>
