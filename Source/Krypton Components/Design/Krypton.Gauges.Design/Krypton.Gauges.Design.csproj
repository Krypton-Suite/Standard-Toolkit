<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\..\Common\Krypton.WinFormsDesignerSdk.Server.props" />

	<PropertyGroup>
		<RootNamespace>Krypton.Gauges</RootNamespace>
		<AssemblyName>Krypton.Gauges.Design</AssemblyName>
		<Description>Out-of-process designers for Krypton.Gauges. Not a separate NuGet package; packed under lib\{tfm}\Design\WinForms\Server\ by Krypton.Standard.Toolkit.</Description>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\..\Utilities\Krypton.Gauges\Components\**\Designers\Designers\**\*.cs" Link="Designers\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\..\Utilities\Krypton.Gauges\Components\**\Designers\Action Lists\**\*.cs" Link="ActionLists\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\..\Common\KryptonDesignerTypeRoutingProvider.cs" Link="KryptonDesignerTypeRoutingProvider.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Utilities\Krypton.Gauges\Krypton.Gauges.csproj" />
		<ProjectReference Include="..\Krypton.Toolkit.Design\Krypton.Toolkit.Design.csproj" />
		<ProjectReference Include="..\..\Shared\Krypton.Shared\Krypton.Shared.csproj" PrivateAssets="all" />
	</ItemGroup>

</Project>
