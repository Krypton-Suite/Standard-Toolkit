<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\..\Core\Krypton.Shared\Krypton.WinFormsDesignerSdk.Server.props" />

	<PropertyGroup>
		<RootNamespace>Krypton.Navigator.Utilities</RootNamespace>
		<AssemblyName>Krypton.Navigator.Utilities.Design</AssemblyName>
		<Description>Out-of-process DesignToolsServer designers, action lists, and glyphs for Krypton.Navigator.Utilities on modern Windows TFMs (WinForms Designer Extensibility SDK). Packed under lib\{tfm}\Design\WinForms\Server\ via Krypton.Standard.Toolkit.</Description>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\..\Utilities\Krypton.Navigator.Utilities\Designers\Designer\**\*.cs" Link="Designers\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\..\Utilities\Krypton.Navigator.Utilities\Designers\Action Lists\**\*.cs" Link="ActionLists\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\..\Core\Krypton.Shared\KryptonDesignerTypeRoutingProvider.cs" Link="KryptonDesignerTypeRoutingProvider.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Utilities\Krypton.Navigator.Utilities\Krypton.Navigator.Utilities.csproj" />
		<ProjectReference Include="..\Krypton.Toolkit.Design\Krypton.Toolkit.Design.csproj" />
		<ProjectReference Include="..\..\Core\Krypton.Interop\Krypton.Interop.csproj" PrivateAssets="all" />
	</ItemGroup>

</Project>
