<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\Krypton.Shared\Krypton.WinFormsDesignerSdk.Server.props" />

	<PropertyGroup>
		<RootNamespace>Krypton.Toolkit</RootNamespace>
		<AssemblyName>Krypton.Toolkit.Design</AssemblyName>
		<Description>Out-of-process DesignToolsServer designers, action lists, and glyphs for Krypton.Toolkit controls on modern Windows TFMs (WinForms Designer Extensibility SDK). Packed under lib\{tfm}\Design\WinForms\Server\.</Description>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\Krypton.Toolkit\Designers\Designers\**\*.cs" Link="Designers\Designers\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\Krypton.Toolkit\Designers\Action Lists\**\*.cs" Link="Designers\Action Lists\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\Krypton.Toolkit\Designers\KryptonVScrollBarDesigner.cs" Link="Designers\KryptonVScrollBarDesigner.cs" />
		<Compile Include="..\Krypton.Toolkit\Designers\Other\KryptonDesignerActionItem.cs" Link="Designers\Other\KryptonDesignerActionItem.cs" />
		<Compile Include="..\Krypton.Toolkit\Designers\Other\KryptonDesignerSdkCompat.cs" Link="Designers\Other\KryptonDesignerSdkCompat.cs" />
		<Compile Include="..\Krypton.Toolkit\Designers\Other\KryptonSplitContainerGlyph.cs" Link="Designers\Other\KryptonSplitContainerGlyph.cs" />
		<Compile Include="..\Krypton.Toolkit\Designers\Other\KryptonSplitContainerBehavior.cs" Link="Designers\Other\KryptonSplitContainerBehavior.cs" />
		<Compile Include="..\Krypton.Shared\KryptonDesignerTypeRoutingProvider.cs" Link="KryptonDesignerTypeRoutingProvider.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Krypton.Toolkit\Krypton.Toolkit 2022.csproj" />
		<ProjectReference Include="..\Krypton.Toolkit.Design.Protocol\Krypton.Toolkit.Design.Protocol.csproj" />
		<ProjectReference Include="..\Krypton.Interop\Krypton.Interop.csproj" PrivateAssets="all" />
	</ItemGroup>

</Project>
