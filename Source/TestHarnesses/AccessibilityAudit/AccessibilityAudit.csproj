<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>AccessibilityAudit</RootNamespace>
    <AssemblyName>AccessibilityAudit</AssemblyName>
    <Platforms>AnyCPU</Platforms>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ForceDesignerDPIUnaware>true</ForceDesignerDPIUnaware>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Krypton Components\Core\Krypton.Docking\Krypton.Docking 2022.csproj" />
    <ProjectReference Include="..\..\Krypton Components\Core\Krypton.Ribbon\Krypton.Ribbon 2022.csproj" />    
    <ProjectReference Include="..\..\Krypton Components\Shared\Krypton.Themes\Krypton.Themes.csproj" />
	  <ProjectReference Include="..\..\Krypton Components\Utilities\Krypton.Toolkit.Utilities\Krypton.Toolkit.Utilities.csproj" />
  </ItemGroup>
</Project>
