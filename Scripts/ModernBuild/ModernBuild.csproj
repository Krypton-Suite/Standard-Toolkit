<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	  <TargetFrameworks>net8.0-windows;net9.0-windows;net10.0-windows;net11.0-windows</TargetFrameworks>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<OutputType>Exe</OutputType>
	<Deterministic>true</Deterministic>
	<!-- Set the CheckEolTargetFramework property to false to fix the warning -->
	<CheckEolTargetFramework>false</CheckEolTargetFramework>
	<PlatformTarget>AnyCPU</PlatformTarget>
	<EnableNETAnalyzers>true</EnableNETAnalyzers>
	<NeutralLanguage>en</NeutralLanguage>
	<DisableImplicitNamespaceImports>true</DisableImplicitNamespaceImports>
	<NoWarn>1701;1702</NoWarn>
	<Configurations>Debug;Release</Configurations>
	<WarningLevel>8</WarningLevel>
	<AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'!='Debug'">
	<Optimize>True</Optimize>
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="Terminal.Gui" Condition="'$(TargetFramework)' == 'net8.0-windows'" Version="2.0.0-develop.0" />
	  <PackageReference Include="Terminal.Gui" Condition="'$(TargetFramework)' == 'net9.0-windows'" Version="2.0.0-develop.0" />
	  <PackageReference Include="Terminal.Gui" Condition="'$(TargetFramework)' == 'net10.0-windows'" Version="2.0.1" />
	  <PackageReference Include="Terminal.Gui" Condition="'$(TargetFramework)' == 'net11.0-windows'" Version="2.0.1" />
  </ItemGroup>
</Project>