<Project>

	<!--
	  Phased Krypton.* orchestration: avoids parallel projects racing on shared Bin/<Configuration>/<tfm>/ outputs
	  while still allowing Ribbon + Navigator to build together after Toolkit is complete.
	  Use with msbuild /m on the command line for parallel multi-TFM builds within each project.
	-->
	<PropertyGroup>
		<KryptonComponentsRoot>..\..\Source\Krypton Components</KryptonComponentsRoot>
		<KryptonSharedProject>$(KryptonComponentsRoot)\Shared\Krypton.Shared\Krypton.Shared.csproj</KryptonSharedProject>
		<KryptonToolkitProject>$(KryptonComponentsRoot)\Core\Krypton.Toolkit\Krypton.Toolkit 2022.csproj</KryptonToolkitProject>
		<KryptonThemesProject>$(KryptonComponentsRoot)\Core\Krypton.Themes\Krypton.Themes.csproj</KryptonThemesProject>
		<KryptonRibbonProject>$(KryptonComponentsRoot)\Core\Krypton.Ribbon\Krypton.Ribbon 2022.csproj</KryptonRibbonProject>
		<KryptonNavigatorProject>$(KryptonComponentsRoot)\Core\Krypton.Navigator\Krypton.Navigator 2022.csproj</KryptonNavigatorProject>
		<KryptonWorkspaceProject>$(KryptonComponentsRoot)\Core\Krypton.Workspace\Krypton.Workspace 2022.csproj</KryptonWorkspaceProject>
		<KryptonDockingProject>$(KryptonComponentsRoot)\Core\Krypton.Docking\Krypton.Docking 2022.csproj</KryptonDockingProject>
		<KryptonToolkitJumpListProject>$(KryptonComponentsRoot)\Utilities\Krypton.Toolkit.JumpList\Krypton.Toolkit.JumpList.csproj</KryptonToolkitJumpListProject>
		<KryptonDrawingProject>$(KryptonComponentsRoot)\Utilities\Krypton.Drawing\Krypton.Drawing.csproj</KryptonDrawingProject>
		<KryptonDialogsProject>$(KryptonComponentsRoot)\Utilities\Krypton.Dialogs\Krypton.Dialogs.csproj</KryptonDialogsProject>
		<KryptonNavigatorUtilitiesProject>$(KryptonComponentsRoot)\Utilities\Krypton.Navigator.Utilities\Krypton.Navigator.Utilities.csproj</KryptonNavigatorUtilitiesProject>
		<KryptonToolkitUtilitiesProject>$(KryptonComponentsRoot)\Utilities\Krypton.Toolkit.Utilities\Krypton.Toolkit.Utilities.csproj</KryptonToolkitUtilitiesProject>
		<KryptonChartingProject>$(KryptonComponentsRoot)\Utilities\Krypton.Charting\Krypton.Charting.csproj</KryptonChartingProject>
		<KryptonGraphsProject>$(KryptonComponentsRoot)\Utilities\Krypton.Graphs\Krypton.Graphs.csproj</KryptonGraphsProject>
		<KryptonGaugesProject>$(KryptonComponentsRoot)\Utilities\Krypton.Gauges\Krypton.Gauges.csproj</KryptonGaugesProject>
		<KryptonStandardToolkitProject>$(KryptonComponentsRoot)\Krypton.Standard.Toolkit\Krypton.Standard.Toolkit.csproj</KryptonStandardToolkitProject>
		<KryptonToolkitDesignProtocolProject>$(KryptonComponentsRoot)\Design\Krypton.Toolkit.Design.Protocol\Krypton.Toolkit.Design.Protocol.csproj</KryptonToolkitDesignProtocolProject>
		<KryptonToolkitDesignClientProject>$(KryptonComponentsRoot)\Design\Krypton.Toolkit.Design.Client\Krypton.Toolkit.Design.Client.csproj</KryptonToolkitDesignClientProject>
		<KryptonToolkitDesignProject>$(KryptonComponentsRoot)\Design\Krypton.Toolkit.Design\Krypton.Toolkit.Design.csproj</KryptonToolkitDesignProject>
		<KryptonRibbonDesignProject>$(KryptonComponentsRoot)\Design\Krypton.Ribbon.Design\Krypton.Ribbon.Design.csproj</KryptonRibbonDesignProject>
		<KryptonNavigatorDesignProject>$(KryptonComponentsRoot)\Design\Krypton.Navigator.Design\Krypton.Navigator.Design.csproj</KryptonNavigatorDesignProject>
		<KryptonWorkspaceDesignProject>$(KryptonComponentsRoot)\Design\Krypton.Workspace.Design\Krypton.Workspace.Design.csproj</KryptonWorkspaceDesignProject>
		<KryptonToolkitUtilitiesDesignProject>$(KryptonComponentsRoot)\Design\Krypton.Toolkit.Utilities.Design\Krypton.Toolkit.Utilities.Design.csproj</KryptonToolkitUtilitiesDesignProject>
		<KryptonGaugesDesignProject>$(KryptonComponentsRoot)\Design\Krypton.Gauges.Design\Krypton.Gauges.Design.csproj</KryptonGaugesDesignProject>
		<KryptonNavigatorUtilitiesDesignProject>$(KryptonComponentsRoot)\Design\Krypton.Navigator.Utilities.Design\Krypton.Navigator.Utilities.Design.csproj</KryptonNavigatorUtilitiesDesignProject>
		<KryptonChartingDesignProject>$(KryptonComponentsRoot)\Design\Krypton.Charting.Design\Krypton.Charting.Design.csproj</KryptonChartingDesignProject>
		<KryptonGraphsDesignProject>$(KryptonComponentsRoot)\Design\Krypton.Graphs.Design\Krypton.Graphs.Design.csproj</KryptonGraphsDesignProject>
		<KryptonWinFormsDesignerSdkBuild Condition="'$(ExcludeModernTargetFrameworks)' == 'true'">false</KryptonWinFormsDesignerSdkBuild>
		<KryptonWinFormsDesignerSdkBuild Condition="'$(KryptonWinFormsDesignerSdkBuild)' == ''">true</KryptonWinFormsDesignerSdkBuild>
		<KryptonComponentBuildProperties Condition="'$(TFMs)' != ''">Configuration=$(Configuration);TFMs=$(TFMs);UseArtifactsOutput=$(UseArtifactsOutput)</KryptonComponentBuildProperties>
		<KryptonComponentBuildProperties Condition="'$(TFMs)' == ''">Configuration=$(Configuration);TFMs=all;UseArtifactsOutput=$(UseArtifactsOutput)</KryptonComponentBuildProperties>
		<KryptonComponentBuildProperties Condition="'$(ExcludeNet11)' != ''">$(KryptonComponentBuildProperties);ExcludeNet11=$(ExcludeNet11)</KryptonComponentBuildProperties>
		<KryptonComponentBuildProperties Condition="'$(ExcludeModernTargetFrameworks)' != ''">$(KryptonComponentBuildProperties);ExcludeModernTargetFrameworks=$(ExcludeModernTargetFrameworks)</KryptonComponentBuildProperties>
		<KryptonComponentBuildProperties Condition="'$(ExcludeVs2022UnsupportedTargetFrameworks)' != ''">$(KryptonComponentBuildProperties);ExcludeVs2022UnsupportedTargetFrameworks=$(ExcludeVs2022UnsupportedTargetFrameworks)</KryptonComponentBuildProperties>
	</PropertyGroup>

	<ItemGroup>
		<KryptonParallelAfterToolkit Include="$(KryptonRibbonProject)" />
		<KryptonParallelAfterToolkit Include="$(KryptonNavigatorProject)" />
		<KryptonParallelDesignAfterToolkit Include="$(KryptonRibbonDesignProject)" />
		<KryptonParallelDesignAfterToolkit Include="$(KryptonNavigatorDesignProject)" />
		<KryptonParallelDesignUtilities Include="$(KryptonToolkitUtilitiesDesignProject)" />
		<KryptonParallelDesignUtilities Include="$(KryptonNavigatorUtilitiesDesignProject)" />
		<KryptonParallelDesignUtilities Include="$(KryptonChartingDesignProject)" />
		<KryptonParallelDesignUtilities Include="$(KryptonGraphsDesignProject)" />
		<KryptonParallelDesignUtilities Include="$(KryptonGaugesDesignProject)" />
	</ItemGroup>

	<Target Name="KryptonCleanNuGetRestoreState" BeforeTargets="Restore">
		<ItemGroup>
			<KryptonNuGetAssets Include="$(KryptonComponentsRoot)\Krypton.*\obj\*.json" />
			<KryptonNuGetAssets Include="$(KryptonComponentsRoot)\Core\Krypton.*\obj\*.json" />
			<KryptonNuGetAssets Include="$(KryptonComponentsRoot)\Design\Krypton.*\obj\*.json" />
			<KryptonNuGetAssets Include="$(KryptonComponentsRoot)\Utilities\Krypton.*\obj\*.json" />
			<KryptonNuGetAssets Include="$(KryptonComponentsRoot)\Krypton.*\obj\*.cache" />
			<KryptonNuGetAssets Include="$(KryptonComponentsRoot)\Core\Krypton.*\obj\*.cache" />
			<KryptonNuGetAssets Include="$(KryptonComponentsRoot)\Design\Krypton.*\obj\*.cache" />
			<KryptonNuGetAssets Include="$(KryptonComponentsRoot)\Utilities\Krypton.*\obj\*.cache" />
			<KryptonNuGetAssets Include="$(KryptonComponentsRoot)\Krypton.*\obj\*.g.targets" />
			<KryptonNuGetAssets Include="$(KryptonComponentsRoot)\Core\Krypton.*\obj\*.g.targets" />
			<KryptonNuGetAssets Include="$(KryptonComponentsRoot)\Design\Krypton.*\obj\*.g.targets" />
			<KryptonNuGetAssets Include="$(KryptonComponentsRoot)\Utilities\Krypton.*\obj\*.g.targets" />
			<KryptonNuGetAssets Include="$(KryptonComponentsRoot)\Krypton.*\obj\*.g.props" />
			<KryptonNuGetAssets Include="$(KryptonComponentsRoot)\Core\Krypton.*\obj\*.g.props" />
			<KryptonNuGetAssets Include="$(KryptonComponentsRoot)\Design\Krypton.*\obj\*.g.props" />
			<KryptonNuGetAssets Include="$(KryptonComponentsRoot)\Utilities\Krypton.*\obj\*.g.props" />
		</ItemGroup>
		<Delete Files="@(KryptonNuGetAssets)" />
	</Target>

	<Target Name="KryptonBuild">
		<MSBuild Projects="$(KryptonSharedProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Restore;Build" />

		<MSBuild Projects="$(KryptonToolkitProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build" />

		<MSBuild Projects="$(KryptonThemesProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build" />

		<MSBuild Projects="@(KryptonParallelAfterToolkit)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build"
		         BuildInParallel="true" />

		<MSBuild Projects="$(KryptonWorkspaceProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build" />

		<MSBuild Projects="$(KryptonDockingProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build" />

		<!-- Satellite assemblies for Krypton.Standard.Toolkit; sequential to avoid shared-output races. -->
		<MSBuild Projects="$(KryptonDrawingProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build" />
		<!-- Utilities before Dialogs: progress dialog hosts KryptonTransferSpeedGraph. -->
		<MSBuild Projects="$(KryptonToolkitUtilitiesProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build" />
		<MSBuild Projects="$(KryptonDialogsProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build" />
		<MSBuild Projects="$(KryptonToolkitJumpListProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build" />
		<MSBuild Projects="$(KryptonNavigatorUtilitiesProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build" />
		<MSBuild Projects="$(KryptonChartingProject)"
             Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build" />
		<MSBuild Projects="$(KryptonGraphsProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build" />
		<MSBuild Projects="$(KryptonGaugesProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build" />

		<!-- WinForms Designer Extensibility SDK (issue #593): Design DLLs share Bin/<Config>/<tfm>/ with runtimes. -->
		<CallTarget Targets="KryptonBuildDesign" />
	</Target>

	<!--
	  Protocol → Client → Toolkit.Design, then Ribbon/Navigator.Design in parallel, then Workspace.Design,
	  then Utilities.Design in parallel. Runtime projects must already be built (KryptonBuild / PackAll restore).
	  Pack copies these with Exists(); skipping this target silently omits Design/WinForms from nupkgs.
	-->
	<Target Name="KryptonBuildDesign" Condition="'$(KryptonWinFormsDesignerSdkBuild)' != 'false' And Exists('$(KryptonToolkitDesignProject)')">
		<MSBuild Projects="$(KryptonToolkitDesignProtocolProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build" />

		<MSBuild Projects="$(KryptonToolkitDesignClientProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build" />

		<MSBuild Projects="$(KryptonToolkitDesignProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build" />

		<MSBuild Projects="@(KryptonParallelDesignAfterToolkit)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build"
		         BuildInParallel="true" />

		<MSBuild Projects="$(KryptonWorkspaceDesignProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build" />

		<MSBuild Projects="@(KryptonParallelDesignUtilities)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build"
		         BuildInParallel="true" />
	</Target>

	<Target Name="KryptonPack">
		<!-- PackAll Cleans first; rebuild runtimes and designers before Exists() packing. -->
		<CallTarget Targets="KryptonBuild" />

		<MSBuild Projects="$(KryptonToolkitProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Pack" />

		<MSBuild Projects="$(KryptonThemesProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Pack" />

		<MSBuild Projects="@(KryptonParallelAfterToolkit)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Pack"
		         BuildInParallel="true" />

		<MSBuild Projects="$(KryptonWorkspaceProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Pack" />

		<MSBuild Projects="$(KryptonDockingProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Pack" />

		<!-- JumpList is bundled in the aggregate package but is not a Standard.Toolkit project reference. -->
		<MSBuild Projects="$(KryptonToolkitJumpListProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build" />
		<!-- Drawing / Utilities / Dialogs are project references; rebuild so pack still sees them if KryptonBuild is skipped. -->
		<MSBuild Projects="$(KryptonDrawingProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build" />
		<MSBuild Projects="$(KryptonToolkitUtilitiesProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build" />
		<MSBuild Projects="$(KryptonDialogsProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Build" />

		<MSBuild Projects="$(KryptonStandardToolkitProject)"
		         Properties="$(KryptonComponentBuildProperties)"
		         Targets="Pack" />
	</Target>

</Project>
