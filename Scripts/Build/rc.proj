<Project>
	<Import Project="..\..\Directory.Build.props" />
	<Import Project="Krypton.Orchestration.targets" />
	<Import Project="Krypton.Pack.targets" />

	<PropertyGroup>
		<RootFolder>$(MSBuildProjectDirectory)</RootFolder>
		<Configuration>RC</Configuration>
		<RCBuildPath>..\Bin\RC\Zips</RCBuildPath>
		<RCZipName>Krypton-RC</RCZipName>
	</PropertyGroup>

	<Target Name="Clean">
		<ItemGroup>
			<Projects Include="..\..\Source\Krypton Components\Krypton.*\*.csproj" />
		</ItemGroup>
		<MSBuild Projects="@(Projects)" Properties="Configuration=$(Configuration);TFMs=all" Targets="Clean" BuildInParallel="false" />
	</Target>

	<Target Name="Restore">
		<ItemGroup>
			<Projects Include="..\..\Source\Krypton Components\Krypton.*\*.csproj" />
		</ItemGroup>
		<MSBuild Projects="@(Projects)" Properties="Configuration=$(Configuration);TFMs=all" Targets="Restore" BuildInParallel="false" />
	</Target>

	<Target Name="Build" DependsOnTargets="Restore;KryptonBuild" />

	<Target Name="CleanPackages">
		<ItemGroup>
			<NugetPkgs Include="..\Bin\Packages\RC\*.nupkg" />
		</ItemGroup>
		<Delete Files="@(NugetPkgs)" />
	</Target>

	<Target Name="Pack" DependsOnTargets="CleanPackages;PackLite;PackAll" />

	<Target Name="Push">
		<ItemGroup>
			<NugetPkgs Include="..\Bin\Packages\RC\*.$(LibraryVersion).nupkg" />
		</ItemGroup>
		<Exec Command="nuget.exe push %(NugetPkgs.Identity)" />
	</Target>

	<Target Name="CreateRCZip">
		<PropertyGroup>
			<StringDate>$([System.DateTime]::Now.ToString('yyyyMMdd'))</StringDate>
		</PropertyGroup>
		<ItemGroup>
			<DebugApplicationFiles Include="..\Bin\RC\**\*.*" Exclude="..\Bin\RC\*vshost.exe*;..\Bin\RC\**\*.json;..\Bin\RC\**\*.pdb" />
		</ItemGroup>
		<MakeDir Directories="$(RCBuildPath)"/>

		<!-- Using 7-Zip for ZIP creation (compatible with all MSBuild versions) -->
		<Exec Command="7z.exe a -tzip &quot;$(RCBuildPath)\$(RCZipName)_$(StringDate).zip&quot; &quot;..\Bin\RC\*&quot; -x!*.json -x!*.pdb"
		      Condition="Exists('C:\Program Files\7-Zip\7z.exe')"
		      WorkingDirectory="$(RCBuildPath)" />

		<!-- Fallback: Using PowerShell Compress-Archive if 7-Zip not available -->
		<Exec Command="powershell.exe -Command &quot;Get-ChildItem '..\Bin\RC\*' -Recurse | Where-Object {$_.Extension -notin '.json','.pdb'} | Compress-Archive -DestinationPath '$(RCBuildPath)\$(RCZipName)_$(StringDate).zip' -Force&quot;"
		      Condition="!Exists('C:\Program Files\7z.exe')" />
	</Target>

	<Target Name="CreateRCTar">
		<PropertyGroup>
			<StringDate>$([System.DateTime]::Now.ToString('yyyyMMdd'))</StringDate>
		</PropertyGroup>
		<ItemGroup>
			<DebugApplicationFiles Include="..\Bin\RC\**\*.*" Exclude="..\Bin\RC\*vshost.exe*;..\Bin\RC\**\*.json;..\Bin\RC\**\*.pdb" />
		</ItemGroup>
		<MakeDir Directories="$(RCBuildPath)"/>

		<!-- Method 1: Using 7-Zip if available (recommended for Windows) -->
		<Exec Command="7z.exe a -ttar &quot;$(RCBuildPath)\$(RCZipName)_$(StringDate).tar&quot; &quot;..\Bin\RC\*&quot; -x!*.json -x!*.pdb"
		      Condition="Exists('C:\Program Files\7-Zip\7z.exe')"
		      WorkingDirectory="$(RCBuildPath)" />
		<Exec Command="7z.exe a -tgzip &quot;$(RCBuildPath)\$(RCZipName)_$(StringDate).tar.gz&quot; &quot;$(RCBuildPath)\$(RCZipName)_$(StringDate).tar&quot;"
		      Condition="Exists('C:\Program Files\7-Zip\7z.exe')"
		      WorkingDirectory="$(RCBuildPath)" />
		<Delete Files="$(RCBuildPath)\$(RCZipName)_$(StringDate).tar"
		        Condition="Exists('C:\Program Files\7-Zip\7z.exe')" />

		<!-- Method 2: Using PowerShell tar command (Windows 10/11) -->
		<Exec Command="powershell.exe -Command tar -czf &quot;$(RCBuildPath)\$(RCZipName)_$(StringDate)_ps.tar.gz&quot; -C &quot;..\Bin\RC&quot; . --exclude=*.json --exclude=*.pdb"
		      Condition="Exists('C:\Windows\System32\tar.exe')" />

		<!-- Method 3: Using Git Bash tar if available -->
		<Exec Command="&quot;C:\Program Files\Git\bin\bash.exe&quot; -c &quot;cd ../Bin/RC &amp;&amp; tar -czf &quot;$(RCBuildPath)/$(RCZipName)_$(StringDate)_git.tar.gz&quot; * --exclude=*.json --exclude=*.pdb&quot;"
		      Condition="Exists('C:\Program Files\Git\bin\bash.exe')" />
	</Target>

	<Target Name="CreateAllRCArchives" DependsOnTargets="CreateRCZip;CreateRCTar" />
</Project>
